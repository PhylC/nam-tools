NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional override for Supabase password reset emails.
# If unset, the app uses the current browser origin, e.g. http://localhost:3000/update-password locally
# and https://accountplanningtools.com/update-password on the live domain.
NEXT_PUBLIC_PASSWORD_RESET_REDIRECT_URL=https://accountplanningtools.com/update-password

RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@accountplanningtools.co.uk
CONTACT_FROM_EMAIL=hello@accountplanningtools.co.uk

# Optional GA4 analytics. Leave unset to disable analytics locally/non-production.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Temporary internal testing toggle. When true, it is still limited to the
# signed-in Supabase user whose email matches APT_TEST_USER_EMAIL.
# If APT_TEST_USER_EMAIL is unset, test mode is disabled for everyone.
NEXT_PUBLIC_SHOW_PLAN_TOGGLE=false
APT_TEST_USER_EMAIL=
